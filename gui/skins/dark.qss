/* Edit freely: reload via Settings > Apply. */
QWidget { background: #1e1f22; color: #e6e6e6; font-size: 10pt; }
QMenuBar, QMenu { background: #2b2d30; }
QMenu::item:selected, QMenuBar::item:selected { background: #3d6fd8; }
QDialog, QGroupBox { background: #25262a; }
QPushButton { background: #3a3d42; border: 1px solid #50545a; border-radius: 4px; padding: 5px 14px; }
QPushButton:hover { background: #4a4e55; }
QComboBox, QSpinBox, QLineEdit { background: #2b2d30; border: 1px solid #50545a; border-radius: 3px; padding: 3px; }
